#!/usr/bin/env python3
"""Standalone launcher for vosk-errs.

Run directly without installing the package, e.g.:

    bin/vosk-errs ref.txt hyp.txt
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src"))

from vosk_errs.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
